{
  "name": "markdown-preview-compiler",
  "displayName": "Markdown Preview & Compiler",
  "description": "Markdown source, visual editing, live PDF preview and export.",
  "version": "0.2.4",
  "icon": "assets/logo.png",
  "publisher": "serendipity-lin",
  "repository": {
    "type": "git",
    "url": "https://github.com/serendipitylin0731/markdown_preview-compiler.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:markdownCompiler.openPreferred",
    "onCommand:markdownCompiler.source",
    "onCommand:markdownCompiler.split",
    "onCommand:markdownCompiler.visual",
    "onCommand:markdownCompiler.pdf",
    "onCommand:markdownCompiler.export"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownCompiler.openPreferred",
        "title": "Markdown Compiler: 打开上次使用的模式"
      },
      {
        "command": "markdownCompiler.source",
        "title": "Markdown Compiler: 源码编辑"
      },
      {
        "command": "markdownCompiler.split",
        "title": "Markdown Compiler: 分屏预览",
        "icon": {
          "light": "assets/icon-light.svg",
          "dark": "assets/icon-dark.svg"
        }
      },
      {
        "command": "markdownCompiler.visual",
        "title": "Markdown Compiler: 预览编辑"
      },
      {
        "command": "markdownCompiler.pdf",
        "title": "Markdown Compiler: PDF 预览"
      },
      {
        "command": "markdownCompiler.export",
        "title": "Markdown Compiler: 导出 PDF"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownCompiler.split",
          "when": "resourceLangId == markdown",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Compiler",
      "properties": {
        "markdownCompiler.preview.fontFamily": {
          "type": "string",
          "default": "",
          "description": "预览字体；留空时使用当前 VS Code 编辑器字体"
        },
        "markdownCompiler.preview.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 10,
          "maximum": 40
        },
        "markdownCompiler.preview.lineHeight": {
          "type": "number",
          "default": 1.6,
          "minimum": 1,
          "maximum": 3
        },
        "markdownCompiler.preview.paragraphGap": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 48
        },
        "markdownCompiler.preview.maxWidth": {
          "type": "number",
          "default": 860,
          "minimum": 400,
          "maximum": 1800
        },
        "markdownCompiler.preview.syncScroll": {
          "type": "boolean",
          "default": true
        },
        "markdownCompiler.pdf.autoUpdate": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "render:sjtu": "node scripts/render-sjtu-templates.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.17.2",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^6.29.1"
  },
  "overrides": {
    "mermaid": {
      "katex": "^0.19.0"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.5",
    "playwright": "^1.57.0",
    "typescript": "^5.8.3"
  }
}
